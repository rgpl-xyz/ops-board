# Allowlist: a build context holds only what the images need.
# When an image needs another path, add it here explicitly.
*

!global.json
!Directory.Build.props
!.config/dotnet-tools.json
!src/
!apps/web/

# Generated output and local files inside the allowed paths.
**/bin/
**/obj/
**/node_modules/
**/dist/
**/.angular/
**/coverage/
**/test-results/
**/TestResults/
**/.env
**/.env.*
**/*.local.json
